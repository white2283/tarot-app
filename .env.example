# 复制为 .env 后按需修改
# 访问口令:留空 = 免口令开放模式;填写后需输入口令才能使用
ACCESS_CODE=
# ── AI 解读(任何 OpenAI 兼容端点都行)──
# 不填 AI_API_KEY 则 AI 功能关闭,仅规则解读;填了即启用
# 常见端点示例(任选其一):
#   Moonshot: https://api.moonshot.cn/v1      (kimi-k2.7-code / moonshot-v1-128k 等)
#   DeepSeek: https://api.deepseek.com/v1      (deepseek-chat / deepseek-reasoner)
#   OpenAI:   https://api.openai.com/v1        (gpt-4o-mini 等)
#   OpenAI 国内中转 / 本地 vLLM / Ollama 网关:填你自己的 base URL
AI_BASE_URL=https://api.moonshot.cn/v1
AI_API_KEY=
AI_MODEL=moonshot-v1-128k
# 单次输出上限(token)。小上下文/小输出模型可调低(如 2048)
AI_MAX_TOKENS=8192
# 采样温度(0-2)。留空则不传(兼容端点默认 1;推理模型通常只接受 1)
# 需要更稳定输出可设 AI_TEMPERATURE=0.8
AI_TEMPERATURE=
# 服务端口(生产可用 9999;开发 8787,前端 dev 代理指向它)
PORT=8787
# SQLite 数据库文件
DB_PATH=data.db
